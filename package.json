{
  "name": "@dloizides/folder-store",
  "version": "0.2.0",
  "description": "Browser folder storage over the File System Access API: remembered handle, re-permission, support check, Web Locks across tabs, exclusive writes.",
  "keywords": [
    "file-system-access",
    "local-first",
    "web-locks",
    "folder",
    "storage"
  ],
  "author": "dloizides",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openmindednewby/folder-store.git"
  },
  "homepage": "https://github.com/openmindednewby/folder-store#readme",
  "bugs": {
    "url": "https://github.com/openmindednewby/folder-store/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./testing": {
      "require": {
        "types": "./dist/testing/fakeFolder.d.ts",
        "default": "./dist/testing/fakeFolder.js"
      },
      "import": {
        "types": "./dist/testing/fakeFolder.d.mts",
        "default": "./dist/testing/fakeFolder.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "security:audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "fake-indexeddb": "^6.2.7",
    "rimraf": "^5.0.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
